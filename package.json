    "samples": "tsx scripts/make-samples.ts"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.76",
    "@ai-sdk/groq": "^4.0.46",
    "@duckdb/node-api": "^1.5.5-r.5",
    "@libsql/client": "^0.18.0",
    "@mastra/ai-sdk": "^1.10.4",
    "@mastra/core": "^1.68.0",
    "@mastra/duckdb": "latest",
    "@mastra/libsql": "^1.23.1",
    "@mastra/memory": "^1.31.0",
    "@mastra/observability": "latest",
    "@mastra/rag": "^2.6.4",
    "@mozilla/readability": "^0.6.0",
    "ai": "^7.0.109",
    "csv-parse": "^7.0.2",
    "docx": "^9.7.1",
    "exa-js": "^2.22.2",
    "exceljs": "^4.4.0",
