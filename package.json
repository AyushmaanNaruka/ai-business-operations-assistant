{
  "name": "business-operations-assistant",
  "version": "0.1.0",
  "description": "AI Business Operations Assistant: upload documents or a company website, then chat, analyze, research, and generate business deliverables.",
  "main": "index.js",
  "private": true,
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "mastra start",
