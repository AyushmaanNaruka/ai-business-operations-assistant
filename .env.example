# ---- Models (free tier) -------------------------------------------------
# Google AI Studio: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (fast + cheap tier): https://console.groq.com/keys
GROQ_API_KEY=

# ---- Web research -------------------------------------------------------
# Exa ($10 credit monthly, no card): https://exa.ai
EXA_API_KEY=

# Tavily (free for students): https://tavily.com
TAVILY_API_KEY=

# Firecrawl (1000 credits/month free, optional): https://firecrawl.dev
FIRECRAWL_API_KEY=

# Jina Reader needs NO key at 20 rpm. Add one for 500 rpm: https://jina.ai/reader
JINA_API_KEY=

# ---- Storage ------------------------------------------------------------
# Single LibSQL file holds memory, vectors and the evidence ledger
DATABASE_URL=file:./data/app.db

# ---- Limits -------------------------------------------------------------
MAX_UPLOAD_MB=100
DOC_FULL_CONTEXT_TOKEN_LIMIT=25000
SESSION_DOC_TOKEN_BUDGET=60000
SQL_TIMEOUT_MS=15000
SQL_MAX_ROWS=5000
RESEARCH_MAX_PAGES=8
