# Copy to .env and fill in. Never commit .env (or any .env.* file): it holds API keys.
# Full reference: docs/10-SETUP.md

# ---- Models -------------------------------------------------------------
# Set a key for every provider you want to use. Each model tier is a fallback
# chain built from the providers that have a key, paid first, then free
# (src/mastra/models.ts). With only the two free keys the app runs on
# Gemini 2.5 Flash, then Gemini 3.5 Flash Lite, then Groq.

# Anthropic (paid, Claude): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI (paid, GPT): https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google AI Studio (free tier for development, or paid): https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# Groq (free tier for development, or paid): https://console.groq.com/keys
GROQ_API_KEY=

# Allowlist of providers that may ever be called, comma separated. Leave empty to
# allow all four. For company data, set this to paid providers only, e.g.
# MODEL_PROVIDERS=anthropic,openai : free tiers' terms may let the provider use
# prompts and uploaded content to improve their models.
MODEL_PROVIDERS=

# Optional per tier override, comma separated provider/model ids, best first.
# Still filtered by MODEL_PROVIDERS and by which keys are set.
# MODEL_ANALYST=anthropic/claude-sonnet-5,openai/gpt-5.5
# MODEL_WRITER=anthropic/claude-sonnet-5,openai/gpt-5.5
# MODEL_ROUTER=anthropic/claude-haiku-4-5,openai/gpt-5.4-mini
# MODEL_RERANK=anthropic/claude-haiku-4-5
# MODEL_EMBEDDER=openai/text-embedding-3-small
MODEL_ANALYST=
MODEL_WRITER=
MODEL_ROUTER=
MODEL_RERANK=
MODEL_EMBEDDER=

# Set to "off" to use only the first available model per tier, with no fallback.
MODEL_FALLBACK=

# ---- Web research -------------------------------------------------------
# Exa ($10 credit monthly, no card): https://exa.ai
EXA_API_KEY=

# Tavily (free for students): https://tavily.com
TAVILY_API_KEY=

# Firecrawl (1000 credits/month free, optional): https://firecrawl.dev
FIRECRAWL_API_KEY=

# Jina Reader needs NO key at 20 rpm. Add one for 500 rpm: https://jina.ai/reader
JINA_API_KEY=

# Web research never reads private or internal addresses (localhost, 10.x,
# 192.168.x, cloud metadata). Set to 1 only in a trusted single user deployment
# that must research intranet pages.
RESEARCH_ALLOW_PRIVATE_URLS=

# ---- Access and security ------------------------------------------------
# Shared password for the whole chat UI (HTTP Basic). Leave empty for local
# development; set it before sharing the app, and serve it over HTTPS.
APP_ACCESS_PASSWORD=
# Optional user name to go with the password. Empty accepts any user name.
APP_ACCESS_USER=

# Requests per minute per client. 0 switches a limit off.
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_UPLOAD_PER_MINUTE=30
RATE_LIMIT_READ_PER_MINUTE=300
# Set to 1 only behind a reverse proxy you control, so rate limits key on the
# client address from X-Forwarded-For. Otherwise all callers share one limit.
TRUST_PROXY=

# Mastra's hosted observability. Leave unset: when set, traces (which include
# prompts and file content) are sent to Mastra's cloud.
# MASTRA_PLATFORM_ACCESS_TOKEN=

# ---- Storage ------------------------------------------------------------
# Single LibSQL file holds memory, vectors and the evidence ledger
DATABASE_URL=file:./data/app.db

# ---- Limits -------------------------------------------------------------
MAX_UPLOAD_MB=100
CHAT_MAX_BODY_MB=8
DOC_FULL_CONTEXT_TOKEN_LIMIT=25000
SESSION_DOC_TOKEN_BUDGET=60000
SQL_TIMEOUT_MS=15000
SQL_MAX_ROWS=5000
RESEARCH_MAX_PAGES=8
